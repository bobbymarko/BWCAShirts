# Copy this file to .env and fill in your values
PRINTFUL_API_KEY=your_printful_api_key_here
PRINTFUL_STORE_ID=your_store_id_here

# Path to your custom font file (.otf or .ttf)
# If not set, Dancing Script (placeholder) will be used
FONT_PATH=fonts/your_font.otf

# Optional: minimum lake area filter (acres). Default is 10.
MIN_LAKE_AREA_ACRES=10.0
